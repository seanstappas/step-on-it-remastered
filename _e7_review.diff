+    /* Snapshot the board bytes so a death can faithfully reload it. Skip the self-copy
+     * when we are already reloading from our own buffer (reload_board_on_death). */
+    if (bord != w->bord_data && len <= sizeof(w->bord_data)) {
+        size_t k;
