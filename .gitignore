# GitHub Actions & Agents
/.github/
/.agents

# Generated / regenerable (reproducible via tools/ from raw_game/)
# NOTE: /extracted/ and /analysis/decomp/ are tracked for reference assets.
/bin/

# Build outputs & C/C++ compiled binaries
/build/
*.dll
*.o
*.obj
*.exe
*.pdb
*.lib
*.idb
*.ilk

# Emulator ROMs / OS images — never commit (copyright)
*.rom
*.img

# godot-cpp bindings (fetch via: git clone --depth 1 -b 4.3 https://github.com/godotengine/godot-cpp bridge/godot-cpp)
/bridge/godot-cpp/

# Godot engine build outputs & caches
/godot_project/bin/
/godot_project/.godot/
/godot_project/tmp/

